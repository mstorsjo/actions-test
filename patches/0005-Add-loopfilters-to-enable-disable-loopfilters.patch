+AVM_CTRL_USE_TYPE(AV2D_SET_INLOOP_FILTERS, int)
+#define AVM_CTRL_AV2D_SET_DUMP_INTRA_FILE
+
 AVM_CTRL_USE_TYPE(AV2D_SET_RANDOM_ACCESS, int)
 #define AVM_CTRL_AV2D_SET_RANDOM_ACCESS
 
