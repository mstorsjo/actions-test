diff --git a/avm/avm_codec.h b/avm/avm_codec.h
index 5c6fcd6b70..5c78fa96f1 100644
--- a/avm/avm_codec.h
+++ b/avm/avm_codec.h
@@ -602,6 +602,16 @@ typedef enum {
   NUM_OBU_METADATA_TYPES,
 } OBU_METADATA_TYPE;
 
+enum InloopFilterType {
+  INLOOPFILTER_NONE    = 0,
+  INLOOPFILTER_DEBLOCK = 1 << 0,
+  INLOOPFILTER_CDEF    = 1 << 1,
+  INLOOPFILTER_WIENER  = 1 << 2,
+  INLOOPFILTER_CCSO    = 1 << 3,
+  INLOOPFILTER_GDF     = 1 << 4,
+  INLOOPFILTER_ALL     = -1,
+};
+
 /*!\brief Returns string representation of OBU_TYPE.
  *
  * \param[in]     type            The OBU_TYPE to convert to string.
