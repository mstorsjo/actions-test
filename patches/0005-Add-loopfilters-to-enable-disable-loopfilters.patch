   AV2D_SET_RANDOM_ACCESS,
 
   AV2D_SET_BRU_OPT_MODE,
@@ -492,6 +500,9 @@ AVM_CTRL_USE_TYPE(AV2D_SET_ROW_MT, unsigned int)
 AVM_CTRL_USE_TYPE(AV2D_SET_SKIP_FILM_GRAIN, int)
