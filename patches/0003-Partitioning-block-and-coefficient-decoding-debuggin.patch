diff --git a/aom/debug.h b/aom/debug.h
index 8c8847f1eb..b203c56cfa 100644
--- a/aom/debug.h
+++ b/aom/debug.h
@@ -31,5 +31,21 @@
 #define DEBUG_OBU_HDR 0
 #define DEBUG_SEQ_HDR 0
 #define DEBUG_FRAME_HDR 0
+#define DEBUG_BLOCK_INFO 0
+#if DEBUG_BLOCK_INFO
+#define DB_ONLY(x...) x,
+#define BLOCK_TO_DEBUG \
+    cm->current_frame.frame_number == 0 && \
+    mi_row >= 0 && mi_row < 16 && mi_col >= 0 && mi_col < 16
+#define DEBUG_BLOCK_printf(fmt...) \
+    if (BLOCK_TO_DEBUG) printf(fmt)
+#define DEBUG_CF_printf(fmt...) \
+    if (BLOCK_TO_DEBUG && plane > -1 && 1) printf(fmt)
+#else
+#define DB_ONLY(x...)
+#define BLOCK_TO_DEBUG 0
+#define DEBUG_BLOCK_printf(fmt...) do { } while (0)
+#define DEBUG_CF_printf(fmt...) do { } while (0)
