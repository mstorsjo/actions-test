From 14e4b8228fcbdf9d790e4a93e680643d455e60d9 Mon Sep 17 00:00:00 2001
From: "Ronald S. Bultje" <rsbultje@gmail.com>
Date: Wed, 27 Aug 2025 09:03:15 -0400
Subject: [PATCH 1/3] OBU header & sequence header debugging.

---
 av1/decoder/decodeframe.c | 110 ++++++++++++++++++++++++++++++++++++++
 av1/decoder/decoder.h     |   3 ++
 av1/decoder/obu.c         |  53 ++++++++++++++++++
 3 files changed, 166 insertions(+)

diff --git a/av1/decoder/decodeframe.c b/av1/decoder/decodeframe.c
index 4d16673581..6672bac17c 100644
--- a/av1/decoder/decodeframe.c
+++ b/av1/decoder/decodeframe.c
@@ -6180,6 +6180,10 @@ static AOM_INLINE void read_bitdepth(
     aom_internal_error(error_info, AOM_CODEC_UNSUP_BITSTREAM,
                        "Unsupported profile/bit-depth combination");
   }
+#if DEBUG_SEQ_HDR
+        printf("SEQHDR: post-bitdepth[%d]: off=%u\n",
+               seq_params->bit_depth, rb->bit_offset);
+#endif
 }
 
 void av1_read_film_grain_params(AV1_COMMON *cm,
@@ -6610,6 +6614,15 @@ void av1_read_sequence_header(
     } else {
       seq_params->force_screen_content_tools = aom_rb_read_bit(rb);
     }
+#if DEBUG_SEQ_HDR
+        printf("SEQHDR: post-screentools[%x,%d,%d,%d,%d,%d]: off=%u\n",
+               seq_enabled_motion_modes, seq_params->enable_six_param_warp_delta,
+               seq_params->enable_masked_compound,
+               seq_params->order_hint_info.enable_ref_frame_mvs,
+               seq_params->order_hint_info.reduced_ref_frame_mvs_mode,
+               seq_params->force_screen_content_tools,
+               rb->bit_offset);
+#endif
 
     if (seq_params->force_screen_content_tools > 0) {
       if (aom_rb_read_bit(rb)) {
@@ -6653,6 +6666,12 @@ void av1_read_sequence_header(
           (seq_params->lr_tools_disable_mask[0] | DEF_UV_LR_TOOLS_DISABLE_MASK);
     }
   }
+#if DEBUG_SEQ_HDR
+        printf("SEQHDR: post-inloopfilters[cdef:%d,gdf:%d,rst:%d]: off=%u\n",
+               seq_params->enable_cdef, seq_params->enable_gdf,
+               seq_params->enable_restoration,
+               rb->bit_offset);
+#endif
 
   const int is_monochrome = seq_params->monochrome;
   if (is_monochrome) {
@@ -6689,6 +6708,18 @@ void av1_read_sequence_header(
     seq_params->uv_dc_delta_q_enabled = 0;
     seq_params->uv_ac_delta_q_enabled = 0;
   }
+#if DEBUG_SEQ_HDR
+        printf("SEQHDR: post-quantflags[%d,%d,%d,%d,%d,%d,%d,%d]: off=%u\n",
+               seq_params->separate_uv_delta_q,
+               seq_params->equal_ac_dc_q,
+               seq_params->base_y_dc_delta_q,
+               seq_params->y_dc_delta_q_enabled,
+               seq_params->base_uv_dc_delta_q,
+               seq_params->uv_dc_delta_q_enabled,
+               seq_params->base_uv_ac_delta_q,
+               seq_params->uv_ac_delta_q_enabled,
+               rb->bit_offset);
+#endif
 }
 
 // Decodes the user-defined quantization matrices for the given level and stores
@@ -6870,6 +6901,21 @@ void av1_read_sequence_header_beyond_av1(
   seq_params->allow_frame_max_bvp_drl_bits = aom_rb_read_bit(rb);
 #endif  // CONFIG_SEQ_MAX_DRL_BITS
 
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-refmv_setup[%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d]: off=%u\n",
+           seq_params->enable_refmvbank,
+           seq_params->enable_drl_reorder,
+           seq_params->enable_cdef_on_skip_txfm,
+           seq_params->enable_avg_cdf,
+           seq_params->avg_cdf_type,
+           seq_params->explicit_ref_frame_map,
+           seq_params->ref_frames,
+           seq_params->def_max_drl_bits,
+           seq_params->allow_frame_max_drl_bits,
+           seq_params->def_max_bvp_drl_bits,
+           seq_params->allow_frame_max_bvp_drl_bits,
+           rb->bit_offset);
+#endif
   seq_params->num_same_ref_compound = aom_rb_read_literal(rb, 2);
   seq_params->enable_sdp = seq_params->monochrome ? 0 : aom_rb_read_bit(rb);
   seq_params->enable_extended_sdp =
@@ -6893,6 +6939,24 @@ void av1_read_sequence_header_beyond_av1(
 #if MHCCP_RUNTIME_FLAG
   seq_params->enable_mhccp = aom_rb_read_bit(rb);
 #endif
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-mhccp[%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d]: off=%u\n",
+           seq_params->num_same_ref_compound,
+           seq_params->enable_sdp,
+           seq_params->enable_extended_sdp,
+           seq_params->enable_ist,
+           seq_params->enable_inter_ist,
+           seq_params->enable_chroma_dctonly,
+           seq_params->enable_t64_resample,
+           seq_params->enable_inter_ddt,
+           seq_params->reduced_tx_part_set,
+           seq_params->enable_cctx,
+           seq_params->enable_mrls,
+           seq_params->enable_cfl_intra,
+           seq_params->enable_mhccp,
+           rb->bit_offset);
+#endif
+
   uint8_t enable_tip = aom_rb_read_bit(rb);
   if (enable_tip) {
     seq_params->enable_tip = 1 + aom_rb_read_bit(rb);
@@ -6914,6 +6978,19 @@ void av1_read_sequence_header_beyond_av1(
     seq_params->enable_fsc_residual = aom_rb_read_bit(rb);
   }
 #endif  // CONFIG_FSC_RES_HLS
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-fsc[%d,%d,%d,%d,%d,%d,%d,%d]: off=%u\n",
+           seq_params->enable_tip,
+           seq_params->enable_tip_hole_fill,
+           seq_params->enable_mv_traj,
+           seq_params->enable_bawp,
+           seq_params->enable_cwp,
+           seq_params->enable_imp_msk_bld,
+           seq_params->enable_fsc,
+           seq_params->enable_fsc_residual,
+           rb->bit_offset);
+#endif
+
   seq_params->enable_ccso = aom_rb_read_bit(rb);
 #if CONFIG_LF_SUB_PU
   seq_params->enable_lf_sub_pu = aom_rb_read_bit(rb);
@@ -6969,6 +7046,26 @@ void av1_read_sequence_header_beyond_av1(
   } else {
     seq_params->enable_parity_hiding = 0;
   }
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-parity_hiding[%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d]: off=%u\n",
+           seq_params->enable_ccso,
+           seq_params->enable_lf_sub_pu,
+           seq_params->enable_tip_explicit_qp,
+           seq_params->enable_orip,
+           seq_params->enable_opfl_refine,
+           seq_params->enable_ibp,
+           seq_params->enable_adaptive_mvd,
+           seq_params->enable_refinemv,
+           seq_params->enable_tip_refinemv,
+           seq_params->enable_bru,
+           seq_params->enable_mvd_sign_derive,
+           seq_params->enable_flex_mvres,
+           seq_params->cfl_ds_filter_index,
+           seq_params->enable_tcq,
+           seq_params->enable_parity_hiding,
+           rb->bit_offset);
+#endif
+
   seq_params->enable_ext_partitions = aom_rb_read_bit(rb);
   if (seq_params->enable_ext_partitions)
     seq_params->enable_uneven_4way_partitions = aom_rb_read_bit(rb);
@@ -7016,6 +7113,19 @@ void av1_read_sequence_header_beyond_av1(
       seq_params->qm_data_present[i] = false;
     }
   }
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: end of seqhdr[%d,%d,%d,%d,%d,%d,%d,%d]: off=%u\n",
+           seq_params->enable_ext_partitions,
+           seq_params->enable_uneven_4way_partitions,
+           seq_params->max_pb_aspect_ratio_log2_m1 + 1,
+           seq_params->enable_global_motion,
+           seq_params->df_par_bits_minus2 + 2,
+           seq_params->enable_short_refresh_frame_flags,
+           seq_params->enable_ext_seg,
+           seq_params->user_defined_qmatrix,
+           rb->bit_offset);
+#endif
+
 }
 
 static int read_global_motion_params(WarpedMotionParams *params,
diff --git a/av1/decoder/decoder.h b/av1/decoder/decoder.h
index 3907bf8a5c..adc10475b0 100644
--- a/av1/decoder/decoder.h
+++ b/av1/decoder/decoder.h
@@ -30,6 +30,9 @@
 #include "av1/decoder/inspection.h"
 #endif
 
+#define DEBUG_OBU_HDR 0
+#define DEBUG_SEQ_HDR 0
+
 #ifdef __cplusplus
 extern "C" {
 #endif
diff --git a/av1/decoder/obu.c b/av1/decoder/obu.c
index 0f33873b5d..36a4b9fdce 100644
--- a/av1/decoder/obu.c
+++ b/av1/decoder/obu.c
@@ -176,11 +176,23 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
     return 0;
   }
 
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-profile[%d]: off=%u\n",
+           seq_params->profile, rb->bit_offset);
+#endif
+
   const int num_bits_width = aom_rb_read_literal(rb, 4) + 1;
   const int num_bits_height = aom_rb_read_literal(rb, 4) + 1;
   const int max_frame_width = aom_rb_read_literal(rb, num_bits_width) + 1;
   const int max_frame_height = aom_rb_read_literal(rb, num_bits_height) + 1;
 
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-size[bits:%dx%d,max:%dx%d]: off=%u\n",
+           num_bits_width, num_bits_height,
+           max_frame_width, max_frame_height,
+           rb->bit_offset);
+#endif
+
   seq_params->num_bits_width = num_bits_width;
   seq_params->num_bits_height = num_bits_height;
   seq_params->max_frame_width = max_frame_width;
@@ -196,6 +208,12 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
                        seq_params->subsampling_x, seq_params->subsampling_y);
   }
 
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-colorinfo[ss=h:%d,v:%d]: off=%u\n",
+           seq_params->subsampling_x, seq_params->subsampling_y,
+           rb->bit_offset);
+#endif
+
   // Still picture or not
   seq_params->still_picture = aom_rb_read_bit(rb);
   seq_params->reduced_still_picture_hdr = aom_rb_read_bit(rb);
@@ -205,6 +223,12 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
     return 0;
   }
 
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-stillpicture_flags[%d,reduced_hdr:%d]: off=%u\n",
+           seq_params->still_picture, seq_params->reduced_still_picture_hdr,
+           rb->bit_offset);
+#endif
+
   if (seq_params->reduced_still_picture_hdr) {
     seq_params->timing_info_present = 0;
     seq_params->decoder_model_info_present_flag = 0;
@@ -229,6 +253,11 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
     } else {
       seq_params->decoder_model_info_present_flag = 0;
     }
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-timinginfo[%d]: off=%u\n",
+           seq_params->timing_info_present,
+           rb->bit_offset);
+#endif
     seq_params->display_model_info_present_flag = aom_rb_read_bit(rb);
     seq_params->operating_points_cnt_minus_1 =
         aom_rb_read_literal(rb, OP_POINTS_CNT_MINUS_1_BITS);
@@ -299,6 +328,11 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
         seq_params->op_params[i].initial_display_delay = 10;
       }
     }
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-operatingpoints[%d]: off=%u\n",
+           seq_params->operating_points_cnt_minus_1 + 1,
+           rb->bit_offset);
+#endif
   }
   // This decoder supports all levels.  Choose operating point provided by
   // external means
@@ -328,6 +362,11 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
     seq_params->max_tlayer_id = aom_rb_read_literal(rb, TLAYER_BITS);
     seq_params->max_mlayer_id = aom_rb_read_literal(rb, MLAYER_BITS);
   }
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-maxlayerid[t:%d,m:%d]: off=%u\n",
+           seq_params->max_tlayer_id, seq_params->max_mlayer_id,
+           rb->bit_offset);
+#endif
 
   // setup default temporal layer dependency
   setup_default_temporal_layer_dependency_structure(seq_params);
@@ -351,6 +390,11 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
       av1_read_mlayer_dependency_info(seq_params, rb);
     }
   }
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-layerdesc[%d]: off=%u\n",
+           seq_params->mlayer_dependency_present_flag,
+           rb->bit_offset);
+#endif
 #endif  // CONFIG_MULTILAYER_CORE_HLS
 
   av1_read_sequence_header(
@@ -360,6 +404,11 @@ static uint32_t read_sequence_header_obu(AV1Decoder *pbi,
       rb, seq_params);
 
   seq_params->film_grain_params_present = aom_rb_read_bit(rb);
+#if DEBUG_SEQ_HDR
+    printf("SEQHDR: post-filmgrain[%d]: off=%u\n",
+           seq_params->film_grain_params_present,
+           rb->bit_offset);
+#endif
 
   // Sequence header for coding tools beyond AV1
   av1_read_sequence_header_beyond_av1(rb, seq_params, &cm->quant_params,
@@ -1083,6 +1132,10 @@ int aom_decode_frame_from_obus(struct AV1Decoder *pbi, const uint8_t *data,
 #endif  // CONFIG_MULTILAYER_CORE
 #endif  // CONFIG_NEW_OBU_HEADER
 
+#if DEBUG_SEQ_HDR
+      printf("OBU type=%d size=%ld\n",
+             obu_header.type, payload_size);
+#endif
     if (obu_header.type != OBU_TEMPORAL_DELIMITER &&
         obu_header.type != OBU_SEQUENCE_HEADER &&
         obu_header.type != OBU_PADDING) {
-- 
