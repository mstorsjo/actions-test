                                  const tran_low_t *dqcoeff, int plane,
                                  TX_TYPE tx_type, TX_SIZE tx_size,
                                  uint16_t *dst, int stride, int eob,
@@ -1016,7 +1017,7 @@ void av2_inverse_transform_block(const MACROBLOCKD *xd,
