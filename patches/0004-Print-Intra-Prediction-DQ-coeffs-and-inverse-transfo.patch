+          printf("l\n");
+          for (int x = 0; x < txhpx; x++)
+            printf(" %02x", val);
+          printf("\n");
+        } else {
+          printf("t\n");
+          for (int x = 0; x < txwpx; x++)
+            printf(" %02x", val);
+          printf("\n");
+        }
+        hex_dump(dst, dst_stride, txwpx, txhpx, pred_names[plane], hbd);
+      }
     }
+#endif
     return;
   }
 
   // NEED_LEFT
+  int num_left_pixels_needed = 0;
   if (need_left) {
